# 复制为 .env 后修改。生产环境务必使用随机长字符串。
APP_SECRET=change-me-to-a-random-32-byte-secret
# 仅首次建库生效；登录后请在「设置」页修改
INITIAL_PASSWORD=change-me-please

DATA_DIR=./data
DB_PATH=./data/yaogu.db

# HTTPS 部署时改为 1
COOKIE_SECURE=0

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2

DAILY_REFRESH_TIME=15:30
SCHEDULER_ENABLED=1

# 有效行情条目下限：低于该值视为数据源失败，避免空快照清空观察池
MIN_QUOTE_COUNT=1000
